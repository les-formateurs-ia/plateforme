VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — NEVER prefix with VITE_ (would get bundled into client code).
# Used only by scripts/seed-users.mjs, never imported by the app itself.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

GEMINI_API_KEY=
# Optionnel — remplace le modèle Live par défaut codé dans gemini-voice-token
# si Google renomme/déprécie le modèle preview.
GEMINI_LIVE_MODEL=
HEYGEN_API_KEY=

# OAuth Google Calendar (connexion par formateur, création des évènements
# Meet) — voir supabase/functions/google-oauth-*, sync-meet-event.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publique de la fonction google-oauth-callback, enregistrée comme URI de
# redirection autorisée côté Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=
# Origine du front, utilisée pour rediriger le navigateur après le flux OAuth.
FRONTEND_URL=
